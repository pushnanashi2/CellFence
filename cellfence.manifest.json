{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "packages/**"
    ],
    "exclude": [],
    "resourceAdapters": {
      "bullmq": "on",
      "celery": "on",
      "django": "on",
      "drizzle": "on",
      "fastapi": "on",
      "fastify": "on",
      "file": "on",
      "http": "on",
      "kafkajs": "on",
      "nestjs": "on",
      "prisma": "on",
      "queue": "on",
      "query-builder": "on",
      "sql-literal": "on",
      "sqlalchemy": "on",
      "typeorm": "on"
    },
    "requiredRules": [
      "CELLFENCE_UNDECLARED_CONSUMER",
      "CELLFENCE_PUBLIC_SYMBOL_MISMATCH",
      "CELLFENCE_UNDECLARED_RESOURCE_ACCESS"
    ]
  },
