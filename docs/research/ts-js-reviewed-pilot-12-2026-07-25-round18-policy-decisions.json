  "decisionScope": "Resolve the 11 round17 needs_policy findings into explicit policy classes without mutating the sealed round17 labels.",
  "principles": [
    "Round17 sealed labels remain unchanged; policy resolution is a new handoff artifact, not a retroactive label edit.",
    "Accurately observed edges that require an explicit manifest contract are classified as manifest_policy, not out_of_scope.",
    "A finding becomes a detected violation only in a future claim whose pre-registered policy says the observed edge class must be declared or explicitly waived.",
    "Expected framework or tool wiring is not a detector bug merely because it is intentional; intentional wiring still needs a manifest edge, resource contract, or waiver when it crosses the claimed boundary.",
    "No round17 needs_policy finding is excluded from the claim denominator by this artifact."
  ],
  "summary": {
    "round17NeedsPolicyFindings": 11,
    "manifestPolicy": 11,
    "detectedViolationInRound17": 0,
    "outOfScope": 0,
    "detectorSuppression": 0,
    "round17LabelsChanged": 0,
    "projectedIfFuturePolicyAdopted": {
      "blockingSuccesses": 86,
      "blockingTrials": 86,
      "observedBlockingPrecision": 1,
      "oneSided95LowerBound": 0.9657656271508799,
      "claimStatus": "still_insufficient_evidence",
      "reason": "Even if all 11 policy-sensitive findings become true positives under a future pre-registered policy, the pooled lower bound remains below 99%, repository balance still fails, rule-level sample sizes remain too small, and external human/organization labels are still absent."
    }
  },
  "policyClasses": {
    "type_only_consumer_edge": {
      "decision": "Type-only TypeScript imports across cell boundaries are source-level consumer edges for this claim family. They must be declared in consumes or explicitly waived before they can be treated as approved wiring.",
      "futureDispositionIfUndeclared": "detected_violation"
    },
    "build_time_erased_import": {
      "decision": "An import that is erased by a custom build transform is still a build-time dependency edge. The transform must be represented as policy or the edge must be declared.",
      "futureDispositionIfUndeclared": "detected_violation"
    },
    "runtime_codegen_dynamic_loader": {
      "decision": "Function/eval-style runtime code generation and constrained fake require maps are intentional dynamic loader behavior, but they require an explicit dynamic-loader waiver or manifest policy. Fail-closed findings remain correct when no waiver exists.",
      "futureDispositionIfUndeclared": "detected_violation"
    },
    "tooling_manifest_file_resource": {
      "decision": "Tooling reads of workspace/package metadata files are real file-resource accesses. They need resource policy when resource rules are included in the claim.",
      "futureDispositionIfUndeclared": "detected_violation"
    },
    "database_catalog_introspection": {
      "decision": "Database catalog introspection is real database access even when it is expected adapter behavior. The accessed catalog resource or an adapter-level resource capability must be declared.",
      "futureDispositionIfUndeclared": "detected_violation"
    },
    "dynamic_sql_resource": {
      "decision": "Caller-provided or assembled SQL sent to a database client is unresolved database resource access. It needs an explicit capability or waiver; it is not out of scope merely because the adapter intentionally accepts SQL.",
      "futureDispositionIfUndeclared": "detected_violation"
    }
  },
