      "**/codemods/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/dts-test/**",
      "**/e2e/**",
      "**/e2e-tests/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixture-generated/**",
      "**/fixtures/**",
      "**/fixtures-generated/**",
      "**/generated/**",
      "**/guides/**",
      "**/integration-tests/**",
      "**/playground/**",
      "**/playgrounds/**",
      "**/*playground*/**",
      "**/template/**",
      "**/templates/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**",
      "__fixtures__/**",
      "__generated__/**",
      "__mocks__/**",
      "__snapshots__/**",
      "__testfixtures__/**",
      "__tests__/**",
      "bench/**",
      "benchmark/**",
      "benchmarks/**",
      "build/**",
      "codemod/**",
      "codemods/**",
      "demo/**",
      "demos/**",
      "dist/**",
      "dts-test/**",
      "e2e/**",
      "e2e-tests/**",
      "example/**",
      "examples/**",
      "fixture/**",
      "fixture-generated/**",
      "fixtures/**",
      "fixtures-generated/**",
      "generated/**",
      "guides/**",
      "integrations/**",
      "integration-tests/**",
      "playground/**",
      "playgrounds/**",
      "*playground*/**",
      "template/**",
      "templates/**",
      "test/**",
      "tests/**",
      "third_party/**",
      "vendor/**"
