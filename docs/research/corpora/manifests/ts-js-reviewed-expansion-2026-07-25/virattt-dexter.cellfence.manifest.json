        "ModelSelectionState",
        "RunQueryResult",
        "SearchSelectionAppState",
        "SearchSelectionController",
        "SearchSelectionState",
        "SelectionState"
      ],
      "consumes": [
        {
          "cell": "agent"
        },
        {
          "cell": "model"
        },
        {
          "cell": "permissions"
        },
        {
          "cell": "src-root"
        },
        {
          "cell": "tools"
        },
        {
          "cell": "utils"
        }
