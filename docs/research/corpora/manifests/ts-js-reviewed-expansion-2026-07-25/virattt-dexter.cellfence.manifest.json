{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "agent",
      "ownedPaths": [
        "src/agent/**"
      ],
      "publicEntry": "src/agent/index.ts",
      "publicSymbols": [
        "Agent",
        "AgentConfig",
        "AgentEvent",
        "ApprovalDecision",
        "buildSystemPrompt",
        "ContextClearedEvent",
        "DEFAULT_SYSTEM_PROMPT",
        "DoneEvent",
        "getCurrentDate",
        "MemoryFlushEvent",
        "MemoryRecalledEvent",
        "Message",
        "Scratchpad",
        "ScratchpadEntry",
        "ThinkingEvent",
        "ToolApprovalEvent",
        "ToolCallRecord",
        "ToolDeniedEvent",
        "ToolEndEvent",
        "ToolErrorEvent",
        "ToolLimitConfig",
        "ToolLimitEvent",
        "ToolProgressEvent",
        "ToolStartEvent",
        "ToolUsageStatus"
      ],
      "consumes": [
        {
          "cell": "memory"
        },
        {
          "cell": "model"
        },
        {
          "cell": "permissions"
        },
        {
          "cell": "skills"
        },
        {
          "cell": "src-root"
        },
        {
          "cell": "tools"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "commands",
      "ownedPaths": [
        "src/commands/**"
      ],
      "publicEntry": "src/commands/index.ts",
      "publicSymbols": [
