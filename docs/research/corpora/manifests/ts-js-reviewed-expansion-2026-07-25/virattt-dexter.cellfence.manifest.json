        "createApiKeyConfirmSelector",
        "createApprovalSelector",
        "createModelSelector",
        "createProviderSelector",
        "createSearchProviderSelector",
        "CustomEditor",
        "DebugPanelComponent",
        "HintBarComponent",
        "IntroComponent",
        "QuestionPromptComponent",
        "ToolEventComponent",
        "UserQueryComponent",
        "WorkingIndicatorComponent"
      ],
      "consumes": [
