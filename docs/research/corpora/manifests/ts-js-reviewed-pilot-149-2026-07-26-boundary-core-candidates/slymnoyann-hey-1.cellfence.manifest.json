      "publicSymbols": [
        "default",
        "readFile"
      ],
      "consumes": [
        {
          "cell": "data"
        },
        {
          "cell": "indexer"
        },
        {
          "cell": "store"
        },
        {
          "cell": "types"
        }
      ],
