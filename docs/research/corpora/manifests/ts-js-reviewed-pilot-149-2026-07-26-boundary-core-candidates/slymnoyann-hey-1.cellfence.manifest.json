      "publicEntry": "src/store/createToggleStore.ts",
      "publicSymbols": [
        "createToggleStore"
      ],
      "consumes": [
        {
          "cell": "data"
        },
        {
          "cell": "helpers"
        },
        {
          "cell": "indexer"
        },
        {
          "cell": "types"
