          "cell": "data"
        },
        {
          "cell": "helpers"
        },
        {
          "cell": "hooks"
        },
        {
          "cell": "indexer"
        },
        {
          "cell": "src-root"
        },
        {
          "cell": "store"
        },
        {
          "cell": "types"
        }
      ],
      "producesArtifacts": []
    },
    {
