        },
        {
          "cell": "core"
        },
        {
          "cell": "platforms"
        },
        {
          "cell": "shared"
        },
        {
          "cell": "types"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "compiler-sfc",
