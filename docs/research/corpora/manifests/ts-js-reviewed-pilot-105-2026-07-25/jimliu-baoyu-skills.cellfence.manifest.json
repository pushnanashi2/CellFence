{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "packages/baoyu-chrome-cdp/src/**",
      "packages/baoyu-codex-imagegen/src/**",
      "packages/baoyu-fetch/src/**",
      "packages/baoyu-md/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "baoyu-chrome-cdp",
      "ownedPaths": [
        "packages/baoyu-chrome-cdp/src/**"
      ],
      "publicEntry": "packages/baoyu-chrome-cdp/src/index.ts",
      "publicSymbols": [
        "CdpConnection",
        "ChromeChannel",
        "DiscoveredChrome",
        "discoverRunningChromeDebugPort",
        "findChromeExecutable",
        "findExistingChromeDebugPort",
        "getDefaultChromeUserDataDirs",
        "getFreePort",
        "gracefulKillChrome",
        "killChrome",
        "launchChrome",
        "openPageSession",
        "PageSession",
        "PlatformCandidates",
        "resolveSharedChromeProfileDir",
        "sleep",
        "waitForChromeDebugPort"
      ],
      "packageName": "baoyu-chrome-cdp",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "baoyu-codex-imagegen",
      "ownedPaths": [
        "packages/baoyu-codex-imagegen/src/**"
      ],
      "publicEntry": "packages/baoyu-codex-imagegen/src/main.ts",
      "publicSymbols": [],
      "packageName": "baoyu-codex-imagegen",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "baoyu-fetch",
      "ownedPaths": [
        "packages/baoyu-fetch/src/**"
      ],
      "publicEntry": "packages/baoyu-fetch/src/adapters/generic/index.ts",
      "publicSymbols": [
        "genericAdapter"
      ],
      "packageName": "baoyu-fetch",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "baoyu-md",
      "ownedPaths": [
        "packages/baoyu-md/src/**"
      ],
      "publicEntry": "packages/baoyu-md/src/index.ts",
      "publicSymbols": [
        "buildCss",
        "buildHtmlDocument",
        "buildMarkdownDocumentMeta",
        "cleanSummaryText",
        "CliOptions",
        "CODE_BLOCK_THEMES",
        "COLOR_PRESETS",
        "DEFAULT_STYLE",
        "downloadFile",
        "ExtendConfig",
        "extractMermaidBlocks",
        "extractSummaryFromBody",
        "extractTitleFromMarkdown",
        "FONT_FAMILY_MAP",
        "FONT_SIZE_OPTIONS",
        "formatTimestamp",
        "FrontmatterFields",
        "getImageExtension",
        "hashMermaidCode",
        "HashMermaidInput",
        "hljs",
        "HtmlDocumentMeta",
        "ImagePlaceholder",
        "initRenderer",
        "inlineCss",
        "IOpts",
        "loadCodeThemeCss",
        "loadExtendConfig",
        "loadThemeCss",
        "macCodeSvg",
        "MERMAID_VERSION",
        "MermaidBlock",
        "MermaidPreprocessedImage",
        "MermaidPreprocessOptions",
        "MermaidPreprocessResult",
        "MermaidRenderFn",
        "MermaidRenderOptions",
        "modifyHtmlStructure",
        "normalizeCssText",
        "normalizeInlineCss",
        "normalizeThemeCss",
        "parseArgs",
        "parseFrontmatter",
        "ParseResult",
        "pickFirstString",
        "postProcessHtml",
        "preprocessMermaidInMarkdown",
        "printUsage",
        "removeFirstHeading",
        "RendererAPI",
        "renderMarkdown",
        "renderMarkdownDocument",
        "RenderMarkdownDocumentOptions",
        "RenderMarkdownDocumentResult",
        "renderMarkdownFileToHtml",
        "replaceMarkdownImagesWithPlaceholders",
        "replaceMermaidBlocks",
        "resolveColorToken",
        "resolveContentImages",
        "ResolvedImageInfo",
        "resolveFontFamilyToken",
        "resolveImagePath",
        "resolveMarkdownStyle",
        "resolveRenderOptions",
        "serializeFrontmatter",
        "stripWrappingQuotes",
        "StyleConfig",
        "THEME_DIR",
        "THEME_NAMES",
        "THEME_STYLE_DEFAULTS",
        "ThemeName",
        "toFrontmatterString"
      ],
      "packageName": "baoyu-md",
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
