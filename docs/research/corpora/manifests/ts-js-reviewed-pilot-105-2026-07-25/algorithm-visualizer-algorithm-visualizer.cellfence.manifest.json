{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "apis",
      "ownedPaths": [
        "src/apis/**"
      ],
      "publicEntry": "src/apis/index.js",
      "publicSymbols": [
        "AlgorithmApi",
        "GitHubApi",
        "TracerApi",
        "VisualizationApi"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "common",
      "ownedPaths": [
        "src/common/**"
      ],
      "publicEntry": "src/common/config.js",
      "publicSymbols": [
        "exts",
        "languages"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "components",
      "ownedPaths": [
        "src/components/**"
      ],
      "publicEntry": "src/components/index.js",
      "publicSymbols": [
        "App",
        "BaseComponent",
        "Button",
        "CodeEditor",
        "Divider",
        "Ellipsis",
        "ExpandableListItem",
        "FoldableAceEditor",
        "Header",
        "ListItem",
        "Navigator",
        "Player",
        "ProgressBar",
        "ResizableContainer",
        "TabContainer",
        "ToastContainer",
        "VisualizationViewer"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "core",
      "ownedPaths": [
        "src/core/**"
      ],
      "publicEntry": "src/core/layouts/HorizontalLayout.js",
      "publicSymbols": [
        "default"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "files",
      "ownedPaths": [
        "src/files/**"
      ],
      "publicEntry": "src/files/index.js",
      "publicSymbols": [
        "CODE_CPP",
        "CODE_JAVA",
        "CODE_JS",
        "ROOT_README_MD",
        "SCRATCH_PAPER_README_MD"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "reducers",
      "ownedPaths": [
        "src/reducers/**"
      ],
      "publicEntry": "src/reducers/index.js",
      "publicSymbols": [
        "actions",
        "current",
        "directory",
        "env",
        "player",
        "toast"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "src-root",
      "ownedPaths": [
        "src/*"
      ],
      "publicEntry": "src/index.js",
      "publicSymbols": [],
      "consumes": [
        {
          "cell": "components"
        },
        {
          "cell": "reducers"
        }
      ],
      "producesArtifacts": []
    }
  ]
}
