{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "packages/cli/src/**",
      "packages/core/src/**",
      "packages/electron/src/**",
      "packages/ui/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "claude-code-router",
      "ownedPaths": [
        "packages/cli/src/**"
      ],
      "publicEntry": "packages/cli/src/cli.ts",
      "publicSymbols": [],
      "packageName": "@musistudio/claude-code-router",
      "consumes": [
        {
          "cell": "core"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "core",
      "ownedPaths": [
        "packages/core/src/**"
      ],
      "publicEntry": "packages/core/src/agents/bot-gateway/env.ts",
      "publicSymbols": [
        "botGatewayProfileEnv"
      ],
      "packageName": "@claude-code-router/core",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "electron",
      "ownedPaths": [
        "packages/electron/src/**"
      ],
      "publicEntry": "packages/electron/src/main/app-menu.ts",
      "publicSymbols": [
        "setupApplicationMenu"
      ],
      "packageName": "@claude-code-router/electron",
      "consumes": [
        {
          "cell": "core"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "ui",
      "ownedPaths": [
        "packages/ui/src/**"
      ],
      "publicEntry": "packages/ui/src/components/ui/badge.tsx",
      "publicSymbols": [
        "Badge",
        "BadgeProps",
        "badgeVariants"
      ],
      "packageName": "@claude-code-router/ui",
      "consumes": [
        {
          "cell": "core"
        }
      ],
      "producesArtifacts": []
    }
  ]
}
