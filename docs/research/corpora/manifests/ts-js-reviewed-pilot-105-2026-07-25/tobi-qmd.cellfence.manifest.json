{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "cli",
      "ownedPaths": [
        "src/cli/**"
      ],
      "publicEntry": "src/cli/formatter.ts",
      "publicSymbols": [
        "addLineNumbers",
        "DocumentResult",
        "documentsToCsv",
        "documentsToFiles",
        "documentsToJson",
        "documentsToMarkdown",
        "documentsToXml",
        "documentToJson",
        "documentToMarkdown",
        "documentToXml",
        "escapeCSV",
        "escapeXml",
        "formatDocument",
        "formatDocuments",
        "FormatOptions",
        "formatSearchResults",
        "getDocid",
        "MultiGetFile",
        "MultiGetResult",
        "OutputFormat",
        "SearchResult",
        "searchResultsToCsv",
        "searchResultsToFiles",
        "searchResultsToJson",
        "searchResultsToMarkdown",
        "searchResultsToMcpCsv",
        "searchResultsToXml"
      ],
      "consumes": [
        {
          "cell": "mcp"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "mcp",
      "ownedPaths": [
        "src/mcp/**"
      ],
      "publicEntry": "src/mcp/server.ts",
      "publicSymbols": [
        "HttpServerHandle",
        "McpStartupOptions",
        "startMcpHttpServer",
        "startMcpServer"
      ],
      "consumes": [
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "src-root",
      "ownedPaths": [
        "src/*"
      ],
      "publicEntry": "src/index.ts",
      "publicSymbols": [
        "addLineNumbers",
        "ChunkStrategy",
        "Collection",
        "CollectionConfig",
        "ContextMap",
        "createStore",
        "DEFAULT_MULTI_GET_MAX_BYTES",
        "DocumentExcludedByIgnore",
        "DocumentLookupError",
        "DocumentNotFound",
        "DocumentResult",
        "EmbedProgress",
        "EmbedResult",
        "ExpandedQuery",
        "ExpandQueryOptions",
        "extractSnippet",
        "getDefaultDbPath",
        "HybridQueryExplain",
        "HybridQueryOptions",
        "HybridQueryResult",
        "IndexHealthInfo",
        "IndexStatus",
        "InternalStore",
        "LexSearchOptions",
        "Maintenance",
        "MultiGetResult",
        "NamedCollection",
        "QMDStore",
        "ReindexProgress",
        "ReindexResult",
        "SearchHooks",
        "SearchOptions",
        "SearchResult",
        "StoreOptions",
        "StructuredSearchOptions",
        "UpdateProgress",
        "UpdateResult",
        "VectorSearchOptions"
      ],
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
