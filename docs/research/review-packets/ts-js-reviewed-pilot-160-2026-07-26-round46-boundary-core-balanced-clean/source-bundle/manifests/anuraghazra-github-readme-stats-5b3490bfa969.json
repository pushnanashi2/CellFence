{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "api/**",
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "api",
      "ownedPaths": [
        "api/**"
      ],
      "publicEntry": "api/index.js",
      "publicSymbols": [
        "default"
      ],
      "consumes": [
        {
          "cell": "cards"
        },
        {
          "cell": "common"
        },
        {
          "cell": "fetchers"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "cards",
      "ownedPaths": [
        "src/cards/**"
      ],
      "publicEntry": "src/cards/index.js",
      "publicSymbols": [
        "renderRepoCard",
        "renderStatsCard",
        "renderTopLanguages",
        "renderWakatimeCard"
      ],
      "consumes": [
        {
          "cell": "common"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "common",
      "ownedPaths": [
        "src/common/**"
      ],
      "publicEntry": "src/common/index.js",
      "publicSymbols": [
        "blacklist",
        "Card",
        "ERROR_CARD_LENGTH",
        "flexLayout",
        "I18n",
        "icons",
        "measureText",
        "renderError",
        "retryer"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "fetchers",
      "ownedPaths": [
        "src/fetchers/**"
      ],
      "publicEntry": "src/fetchers/gist.js",
      "publicSymbols": [
        "default",
        "fetchGist"
      ],
      "consumes": [
        {
          "cell": "common"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "src-root",
      "ownedPaths": [
        "src/*"
      ],
      "publicEntry": "src/index.js",
      "publicSymbols": [
        "blacklist",
        "Card",
        "ERROR_CARD_LENGTH",
        "flexLayout",
        "I18n",
        "icons",
        "measureText",
        "renderError",
        "renderRepoCard",
        "renderStatsCard",
        "renderTopLanguages",
        "renderWakatimeCard",
        "retryer"
      ],
      "consumes": [
        {
          "cell": "cards"
        },
        {
          "cell": "common"
        }
      ],
      "producesArtifacts": []
    }
  ]
}
