      ],
      "publicEntry": "packages/env/src/marketing/index.ts",
      "publicSymbols": [
        "env"
      ],
      "packageName": "@orbitkit/env",
      "consumes": [
        {
          "cell": "eslint"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "eslint",
      "ownedPaths": [
        "packages/config/eslint/src/**"
      ],
      "publicEntry": "packages/config/eslint/src/index.js",
      "publicSymbols": [
        "configs",
        "defineConfig"
      ],
      "packageName": "@orbitkit/eslint",
      "consumes": [
        {
          "cell": "config"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "marketing",
      "ownedPaths": [
