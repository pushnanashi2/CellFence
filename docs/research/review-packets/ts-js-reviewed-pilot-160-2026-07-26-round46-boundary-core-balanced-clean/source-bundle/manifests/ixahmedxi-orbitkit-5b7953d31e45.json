        "AccordionContent",
        "AccordionItem",
        "AccordionTrigger"
      ],
      "packageName": "@orbitkit/ui",
      "consumes": [
        {
          "cell": "eslint"
        },
        {
          "cell": "storybook"
        },
        {
          "cell": "tailwind"
        },
        {
          "cell": "vite"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "utils",
      "ownedPaths": [
        "packages/utils/src/**"
      ],
      "publicEntry": "packages/utils/src/filesystem.ts",
      "publicSymbols": [
        "getAbsolutePath"
      ],
      "packageName": "@orbitkit/utils",
      "consumes": [
