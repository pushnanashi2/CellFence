{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "apps/marketing/src/**",
      "apps/web/src/**",
      "packages/api/src/**",
      "packages/auth/src/**",
      "packages/config/eslint/**",
      "packages/config/eslint/src/**",
      "packages/config/storybook/**",
      "packages/config/storybook/src/**",
      "packages/config/tailwind/**",
      "packages/config/tailwind/src/**",
      "packages/config/vite/**",
      "packages/config/vite/src/**",
      "packages/core/src/**",
      "packages/db/src/**",
      "packages/env/src/**",
      "packages/ui/src/**",
      "packages/utils/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__generated__/**",
      "**/__mocks__/**",
      "**/__snapshots__/**",
      "**/__testfixtures__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.snap",
      "**/*.snapshot.*",
      "**/*.spec.*",
      "**/*.test-*.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/codemod/**",
      "**/codemods/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/dts-test/**",
      "**/e2e/**",
      "**/e2e-tests/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixture-generated/**",
      "**/fixtures/**",
      "**/fixtures-generated/**",
      "**/generated/**",
      "**/guides/**",
      "**/integration-tests/**",
      "**/playground/**",
      "**/playgrounds/**",
      "**/*playground*/**",
      "**/template/**",
      "**/templates/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**",
      "__fixtures__/**",
      "__generated__/**",
      "__mocks__/**",
      "__snapshots__/**",
      "__testfixtures__/**",
      "__tests__/**",
      "bench/**",
      "benchmark/**",
      "benchmarks/**",
      "build/**",
      "codemod/**",
      "codemods/**",
      "demo/**",
      "demos/**",
      "dist/**",
      "dts-test/**",
      "e2e/**",
      "e2e-tests/**",
      "example/**",
      "examples/**",
      "fixture/**",
      "fixture-generated/**",
      "fixtures/**",
      "fixtures-generated/**",
      "generated/**",
      "guides/**",
      "integrations/**",
      "integration-tests/**",
      "playground/**",
      "playgrounds/**",
      "*playground*/**",
      "template/**",
      "templates/**",
      "test/**",
      "tests/**",
      "third_party/**",
      "vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_UNSUPPORTED_TYPESCRIPT_SYNTAX",
      "CELLFENCE_UNSUPPORTED_PYTHON_SYNTAX",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "api",
      "ownedPaths": [
        "packages/api/src/**"
      ],
      "publicEntry": "packages/api/src/index.ts",
      "publicSymbols": [
        "appRouter",
        "AppRouter",
        "createCaller",
        "createTRPCContext"
      ],
      "packageName": "@orbitkit/api",
      "consumes": [
        {
          "cell": "auth"
        },
        {
          "cell": "db"
        },
        {
          "cell": "env"
        },
        {
          "cell": "eslint"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "auth",
      "ownedPaths": [
        "packages/auth/src/**"
      ],
      "publicEntry": "packages/auth/src/index.ts",
      "publicSymbols": [
        "auth",
        "lucia",
        "uncachedAuth"
      ],
      "packageName": "@orbitkit/auth",
      "consumes": [
        {
          "cell": "db"
        },
        {
          "cell": "env"
        },
        {
          "cell": "eslint"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "config",
      "ownedPaths": [
        "packages/config/eslint/**",
        "packages/config/storybook/**",
        "packages/config/tailwind/**",
        "packages/config/vite/**"
      ],
      "publicEntry": "packages/config/eslint/eslint.config.js",
      "publicSymbols": [
        "default"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "core",
      "ownedPaths": [
        "packages/core/src/**"
      ],
      "publicEntry": "packages/core/src/index.ts",
      "publicSymbols": [],
      "packageName": "@orbitkit/core",
      "consumes": [
        {
          "cell": "eslint"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "db",
      "ownedPaths": [
        "packages/db/src/**"
      ],
      "publicEntry": "packages/db/src/index.ts",
      "publicSymbols": [
