        {
          "cell": "eslint"
        },
        {
          "cell": "tailwind"
        },
        {
          "cell": "ui"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "storybook",
      "ownedPaths": [
        "packages/config/storybook/src/**"
      ],
      "publicEntry": "packages/config/storybook/src/configs/react-vite.ts",
      "publicSymbols": [
        "default"
      ],
      "packageName": "@orbitkit/storybook",
      "consumes": [
        {
          "cell": "config"
        },
        {
          "cell": "eslint"
        },
        {
          "cell": "utils"
