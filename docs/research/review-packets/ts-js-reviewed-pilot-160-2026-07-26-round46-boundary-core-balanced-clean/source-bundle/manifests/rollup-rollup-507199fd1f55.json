{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "ast",
      "ownedPaths": [
        "src/ast/**"
      ],
      "publicEntry": "src/ast/bufferParsers.ts",
      "publicSymbols": [
        "convertProgram"
      ],
      "consumes": [
        {
          "cell": "src-root"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "finalisers",
      "ownedPaths": [
        "src/finalisers/**"
      ],
      "publicEntry": "src/finalisers/index.ts",
      "publicSymbols": [
        "default",
        "Finaliser",
        "FinaliserOptions"
      ],
      "consumes": [
        {
          "cell": "src-root"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "rollup",
      "ownedPaths": [
        "src/rollup/**"
      ],
      "publicEntry": "src/rollup/rollup.ts",
      "publicSymbols": [
        "default",
        "defineConfig",
        "rollupInternal"
      ],
      "consumes": [
        {
          "cell": "src-root"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "src-root",
      "ownedPaths": [
        "src/*"
      ],
      "publicEntry": "src/browser-entry.ts",
      "publicSymbols": [
        "defineConfig",
        "rollup",
        "VERSION"
      ],
      "consumes": [
        {
          "cell": "ast"
        },
        {
          "cell": "finalisers"
        },
        {
          "cell": "rollup"
        },
        {
          "cell": "utils"
        },
        {
          "cell": "watch"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "utils",
      "ownedPaths": [
        "src/utils/**"
      ],
      "publicEntry": "src/utils/addons.ts",
      "publicSymbols": [
        "Addons",
        "createAddons"
      ],
      "consumes": [
        {
          "cell": "ast"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "watch",
      "ownedPaths": [
        "src/watch/**"
      ],
      "publicEntry": "src/watch/fileWatcher.ts",
      "publicSymbols": [
        "FileWatcher"
      ],
      "consumes": [
        {
          "cell": "rollup"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    }
  ]
}
