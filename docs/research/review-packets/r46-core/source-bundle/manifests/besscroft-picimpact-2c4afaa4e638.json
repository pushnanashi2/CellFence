{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "app/**",
      "components/**",
      "hooks/**",
      "lib/**",
      "server/**",
      "stores/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__generated__/**",
      "**/__mocks__/**",
      "**/__snapshots__/**",
      "**/__testfixtures__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.snap",
      "**/*.snapshot.*",
      "**/*.spec.*",
      "**/*.test-*.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/codemod/**",
      "**/codemods/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/dts-test/**",
      "**/e2e/**",
      "**/e2e-tests/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixture-generated/**",
      "**/fixtures/**",
      "**/fixtures-generated/**",
      "**/generated/**",
      "**/guides/**",
      "**/integration-tests/**",
      "**/playground/**",
      "**/playgrounds/**",
      "**/*playground*/**",
      "**/template/**",
      "**/templates/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**",
      "__fixtures__/**",
      "__generated__/**",
      "__mocks__/**",
      "__snapshots__/**",
      "__testfixtures__/**",
      "__tests__/**",
      "bench/**",
      "benchmark/**",
      "benchmarks/**",
      "build/**",
      "codemod/**",
      "codemods/**",
      "demo/**",
      "demos/**",
      "dist/**",
      "dts-test/**",
      "e2e/**",
      "e2e-tests/**",
      "example/**",
      "examples/**",
      "fixture/**",
      "fixture-generated/**",
      "fixtures/**",
      "fixtures-generated/**",
      "generated/**",
      "guides/**",
      "integrations/**",
      "integration-tests/**",
      "playground/**",
      "playgrounds/**",
      "*playground*/**",
      "template/**",
      "templates/**",
      "test/**",
      "tests/**",
      "third_party/**",
      "vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_UNSUPPORTED_TYPESCRIPT_SYNTAX",
      "CELLFENCE_UNSUPPORTED_PYTHON_SYNTAX",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "app",
      "ownedPaths": [
        "app/**"
      ],
      "publicEntry": "app/(default)/layout.tsx",
      "publicSymbols": [
        "default"
      ],
      "consumes": [
        {
          "cell": "components"
        },
        {
          "cell": "hooks"
        },
        {
          "cell": "lib"
        },
        {
          "cell": "server"
        },
        {
          "cell": "stores"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "components",
      "ownedPaths": [
        "components/**"
      ],
      "publicEntry": "components/admin/album/album-add-button.tsx",
      "publicSymbols": [
        "default"
      ],
      "consumes": [
        {
          "cell": "app"
        },
        {
          "cell": "hooks"
        },
        {
          "cell": "lib"
        },
        {
          "cell": "server"
        },
        {
          "cell": "stores"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "hooks",
      "ownedPaths": [
        "hooks/**"
      ],
      "publicEntry": "hooks/use-avif-support.ts",
      "publicSymbols": [
        "useAvifSupport"
      ],
      "consumes": [
        {
          "cell": "lib"
        },
        {
          "cell": "server"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "lib",
      "ownedPaths": [
        "lib/**"
      ],
      "publicEntry": "lib/github/get-contributors.ts",
      "publicSymbols": [
        "Contributor",
        "fetchContributors"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "server",
      "ownedPaths": [
        "server/**"
      ],
      "publicEntry": "server/actions/images.ts",
      "publicSymbols": [
        "getAlbumDisplayConfig",
        "getAlbumNeighborWindow",
        "getDisplayConfig",
        "getImagesData",
        "getImagesPageTotal",
        "initDailyIfNeeded"
      ],
      "consumes": [
        {
          "cell": "lib"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "stores",
      "ownedPaths": [
        "stores/**"
      ],
      "publicEntry": "stores/button-stores.ts",
      "publicSymbols": [
        "ButtonActions",
        "ButtonState",
        "ButtonStore",
        "createButtonStore",
        "defaultInitState",
        "initButtonStore"
      ],
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
