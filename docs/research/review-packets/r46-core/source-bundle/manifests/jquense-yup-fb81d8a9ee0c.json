{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "src-root",
      "ownedPaths": [
        "src/*"
      ],
      "publicEntry": "src/index.ts",
      "publicSymbols": [
        "addMethod",
        "AnyMessageParams",
        "AnyObject",
        "AnyObjectSchema",
        "AnySchema",
        "array",
        "ArraySchema",
        "Asserts",
        "bool",
        "boolean",
        "BooleanSchema",
        "CastOptions",
        "CreateErrorOptions",
        "CustomSchemaMetadata",
        "date",
        "DateSchema",
        "DefaultFromShape",
        "defaultLocale",
        "DefaultThunk",
        "Defined",
        "Flags",
        "getIn",
        "InferType",
        "ISchema",
        "isSchema",
        "lazy",
        "Lazy",
        "LazySchema",
        "LocaleObject",
        "MakePartial",
        "Maybe",
        "Message",
        "MessageParams",
        "mixed",
        "MixedOptions",
        "MixedSchema",
        "MixedTypeGuard",
        "NotNull",
        "number",
        "NumberSchema",
        "object",
        "ObjectSchema",
        "ObjectShape",
        "Optionals",
        "printValue",
        "reach",
        "ref",
        "Reference",
        "Schema",
        "SchemaDescription",
        "SchemaFieldDescription",
        "SchemaInnerTypeDescription",
        "SchemaLazyDescription",
        "SchemaMetadata",
        "SchemaObjectDescription",
        "SchemaRefDescription",
        "SchemaSpec",
        "SetFlag",
        "setLocale",
        "string",
        "StringSchema",
        "TestConfig",
        "TestContext",
        "TestFunction",
        "TestOptions",
        "ToggleDefault",
        "tuple",
        "TupleSchema",
        "TypeFromShape",
        "UnsetFlag",
        "ValidateOptions",
        "ValidationError"
      ],
      "consumes": [
        {
          "cell": "util"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "util",
      "ownedPaths": [
        "src/util/**"
      ],
      "publicEntry": "src/util/cloneDeep.ts",
      "publicSymbols": [
        "default"
      ],
      "consumes": [
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    }
  ]
}
