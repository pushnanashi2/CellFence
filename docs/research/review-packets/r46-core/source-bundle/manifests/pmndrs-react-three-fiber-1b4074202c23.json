{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "example/src/**",
      "packages/eslint-plugin/src/**",
      "packages/fiber/src/**",
      "packages/shared/**",
      "packages/test-renderer/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "eslint-plugin",
      "ownedPaths": [
        "packages/eslint-plugin/src/**"
      ],
      "publicEntry": "packages/eslint-plugin/src/index.ts",
      "publicSymbols": [
        "configs",
        "rules"
      ],
      "packageName": "@react-three/eslint-plugin",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "example",
      "ownedPaths": [
        "example/src/**"
      ],
      "publicEntry": "example/src/index.tsx",
      "publicSymbols": [],
      "packageName": "example",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "fiber",
      "ownedPaths": [
        "packages/fiber/src/**"
      ],
      "publicEntry": "packages/fiber/src/index.tsx",
      "publicSymbols": [
        "_roots",
        "act",
        "Act",
        "addAfterEffect",
        "addEffect",
        "addTail",
        "advance",
        "applyProps",
        "Args",
        "AttachFnType",
        "AttachType",
        "buildGraph",
        "Camera",
        "CameraProps",
        "Canvas",
        "CanvasProps",
        "Catalogue",
        "Color",
        "ComputeFunction",
        "ConstructorRepresentation",
        "context",
        "createEvents",
        "createPortal",
        "createRoot",
        "Disposable",
        "dispose",
        "DomEvent",
        "Dpr",
        "ElementProps",
        "Euler",
        "EventHandlers",
        "EventManager",
        "EventProps",
        "events",
        "Events",
        "extend",
        "Extensions",
        "FilterFunction",
        "flushGlobalEffects",
        "flushSync",
        "Frameloop",
        "getRootState",
        "GlobalEffectType",
        "GlobalRenderCallback",
        "GLProps",
        "InjectState",
        "Instance",
        "InstanceProps",
        "Intersection",
        "invalidate",
        "Layers",
        "LoaderResult",
        "MathProps",
        "MathRepresentation",
        "MathType",
        "MathTypes",
        "Matrix3",
        "Matrix4",
        "ObjectMap",
        "Performance",
        "Quaternion",
        "RaycastableRepresentation",
        "ReactProps",
        "ReactThreeFiber",
        "reconciler",
        "ReconcilerRoot",
        "RenderCallback",
        "Renderer",
        "RenderProps",
        "RootState",
        "RootStore",
        "Size",
        "Subscription",
        "ThreeElement",
        "ThreeElements",
        "ThreeEvent",
        "ThreeToJSXElements",
        "unmountComponentAtNode",
        "useFrame",
        "useGraph",
        "useInstanceHandle",
        "useLoader",
        "useStore",
        "useThree",
        "Vector2",
        "Vector3",
        "Vector4",
        "VectorRepresentation",
        "Viewport",
        "XRManager"
      ],
      "packageName": "@react-three/fiber",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "shared",
      "ownedPaths": [
        "packages/shared/**"
      ],
      "publicEntry": "packages/shared/setupTests.ts",
      "publicSymbols": [],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "test-renderer",
      "ownedPaths": [
        "packages/test-renderer/src/**"
      ],
      "publicEntry": "packages/test-renderer/src/index.tsx",
      "publicSymbols": [
        "act",
        "create",
        "default",
        "ReactThreeTest",
        "waitFor",
        "WaitOptions"
      ],
      "packageName": "@react-three/test-renderer",
      "consumes": [
        {
          "cell": "fiber"
        }
      ],
      "producesArtifacts": []
    }
  ]
}
