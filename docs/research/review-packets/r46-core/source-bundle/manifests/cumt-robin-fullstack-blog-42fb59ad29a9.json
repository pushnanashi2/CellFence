{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "app/cra-react18/**",
      "app/cra-react18/src/**",
      "app/express-server/**",
      "app/express-server/src/**",
      "app/nest-server/**",
      "app/nest-server/src/**",
      "app/nuxt4-web/**",
      "app/vite-react19/**",
      "app/vite-react19/src/**",
      "app/vite-vue3/**",
      "app/vite-vue3/src/**",
      "app/webpack-vue3/**",
      "app/webpack-vue3/src/**",
      "packages/eslint-config/**",
      "packages/services/src/**",
      "packages/types/src/**",
      "packages/utils/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__generated__/**",
      "**/__mocks__/**",
      "**/__snapshots__/**",
      "**/__testfixtures__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.snap",
      "**/*.snapshot.*",
      "**/*.spec.*",
      "**/*.test-*.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/codemod/**",
      "**/codemods/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/dts-test/**",
      "**/e2e/**",
      "**/e2e-tests/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixture-generated/**",
      "**/fixtures/**",
      "**/fixtures-generated/**",
      "**/generated/**",
      "**/guides/**",
      "**/integration-tests/**",
      "**/playground/**",
      "**/playgrounds/**",
      "**/*playground*/**",
      "**/template/**",
      "**/templates/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**",
      "__fixtures__/**",
      "__generated__/**",
      "__mocks__/**",
      "__snapshots__/**",
      "__testfixtures__/**",
      "__tests__/**",
      "bench/**",
      "benchmark/**",
      "benchmarks/**",
      "build/**",
      "codemod/**",
      "codemods/**",
      "demo/**",
      "demos/**",
      "dist/**",
      "dts-test/**",
      "e2e/**",
      "e2e-tests/**",
      "example/**",
      "examples/**",
      "fixture/**",
      "fixture-generated/**",
      "fixtures/**",
      "fixtures-generated/**",
      "generated/**",
      "guides/**",
      "integrations/**",
      "integration-tests/**",
      "playground/**",
      "playgrounds/**",
      "*playground*/**",
      "template/**",
      "templates/**",
      "test/**",
      "tests/**",
      "third_party/**",
      "vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_UNSUPPORTED_TYPESCRIPT_SYNTAX",
      "CELLFENCE_UNSUPPORTED_PYTHON_SYNTAX",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "app",
      "ownedPaths": [
        "app/cra-react18/**",
        "app/express-server/**",
        "app/nest-server/**",
        "app/vite-react19/**",
        "app/vite-vue3/**",
        "app/webpack-vue3/**"
      ],
      "publicEntry": "app/cra-react18/.eslintrc.cjs",
      "publicSymbols": [],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "cra-react18",
      "ownedPaths": [
        "app/cra-react18/src/**"
      ],
      "publicEntry": "app/cra-react18/src/index.tsx",
      "publicSymbols": [],
      "packageName": "cra-react18",
      "consumes": [
        {
          "cell": "app"
        },
        {
          "cell": "services"
        },
        {
          "cell": "types"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "eslint-config",
      "ownedPaths": [
        "packages/eslint-config/**"
      ],
      "publicEntry": "packages/eslint-config/base.js",
      "publicSymbols": [],
      "packageName": "@fullstack-blog/eslint-config",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "express-server",
      "ownedPaths": [
        "app/express-server/src/**"
