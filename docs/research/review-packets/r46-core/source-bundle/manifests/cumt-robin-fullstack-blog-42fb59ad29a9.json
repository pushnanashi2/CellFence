      "publicEntry": "app/express-server/src/app.js",
      "publicSymbols": [],
      "packageName": "express-server",
      "consumes": [
        {
          "cell": "app"
        },
        {
          "cell": "eslint-config"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "nest-server",
      "ownedPaths": [
        "app/nest-server/src/**"
      ],
      "publicEntry": "app/nest-server/src/app.module.ts",
      "publicSymbols": [
        "AppModule"
      ],
      "packageName": "nest-server",
      "consumes": [
        {
          "cell": "app"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "nuxt4-web",
