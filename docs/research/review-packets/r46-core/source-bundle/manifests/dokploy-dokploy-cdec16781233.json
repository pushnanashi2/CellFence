{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "apps/api/src/**",
      "apps/dokploy/**",
      "apps/schedules/src/**",
      "packages/server/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "api",
      "ownedPaths": [
        "apps/api/src/**"
      ],
      "publicEntry": "apps/api/src/index.ts",
      "publicSymbols": [
        "deploymentFunction",
        "inngest"
      ],
      "packageName": "@dokploy/api",
      "consumes": [
        {
          "cell": "server"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "dokploy",
      "ownedPaths": [
        "apps/dokploy/**"
      ],
      "publicEntry": "apps/dokploy/__test__/setup.ts",
      "publicSymbols": [],
      "packageName": "dokploy",
      "consumes": [
        {
          "cell": "server"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "schedules",
      "ownedPaths": [
        "apps/schedules/src/**"
      ],
      "publicEntry": "apps/schedules/src/index.ts",
      "publicSymbols": [
        "gracefulShutdown"
      ],
      "packageName": "@dokploy/schedules",
      "consumes": [
        {
          "cell": "server"
        }
      ],
      "producesArtifacts": []
    },
