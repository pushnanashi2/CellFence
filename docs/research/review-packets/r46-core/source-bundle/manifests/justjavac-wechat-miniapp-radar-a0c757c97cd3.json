{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "app/**",
      "components/**",
      "lib/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "app",
      "ownedPaths": [
        "app/**"
      ],
      "publicEntry": "app/admin/page.tsx",
      "publicSymbols": [
        "default",
        "dynamic"
      ],
      "consumes": [
        {
          "cell": "components"
        },
        {
          "cell": "lib"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "components",
      "ownedPaths": [
        "components/**"
      ],
      "publicEntry": "components/github-icon.tsx",
      "publicSymbols": [
        "GitHubIcon"
      ],
      "consumes": [
        {
          "cell": "lib"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "lib",
      "ownedPaths": [
        "lib/**"
      ],
      "publicEntry": "lib/admin-auth.ts",
      "publicSymbols": [
        "ADMIN_SESSION_COOKIE",
        "getAdminTokenFromRequest",
        "isAdminConfigured",
        "isAdminRequestAuthorized",
        "isAdminTokenValid"
      ],
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
