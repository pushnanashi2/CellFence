{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "app/**",
      "components/**",
      "contexts/**",
      "hooks/**",
      "lib/**",
      "packages/mcp-server/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "app",
      "ownedPaths": [
        "app/**"
      ],
      "publicEntry": "app/[lang]/about/cn/page.tsx",
      "publicSymbols": [
        "default",
        "metadata"
      ],
      "consumes": [
        {
          "cell": "components"
        },
        {
          "cell": "contexts"
        },
        {
          "cell": "hooks"
        },
        {
          "cell": "lib"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "components",
      "ownedPaths": [
        "components/**"
      ],
      "publicEntry": "components/ai-elements/model-selector.tsx",
      "publicSymbols": [
        "ModelSelector",
        "ModelSelectorContent",
        "ModelSelectorContentProps",
        "ModelSelectorDialog",
        "ModelSelectorDialogProps",
        "ModelSelectorEmpty",
        "ModelSelectorEmptyProps",
        "ModelSelectorGroup",
        "ModelSelectorGroupProps",
        "ModelSelectorInput",
        "ModelSelectorInputProps",
        "ModelSelectorItem",
        "ModelSelectorItemProps",
        "ModelSelectorList",
        "ModelSelectorListProps",
        "ModelSelectorLogo",
        "ModelSelectorLogoGroup",
        "ModelSelectorLogoGroupProps",
        "ModelSelectorLogoProps",
        "ModelSelectorName",
        "ModelSelectorNameProps",
        "ModelSelectorProps",
        "ModelSelectorSectionHeader",
        "ModelSelectorSectionHeaderProps",
        "ModelSelectorSeparator",
        "ModelSelectorSeparatorProps",
        "ModelSelectorShortcut",
        "ModelSelectorShortcutProps",
        "ModelSelectorTrigger",
        "ModelSelectorTriggerProps"
      ],
      "consumes": [
        {
          "cell": "contexts"
        },
        {
          "cell": "hooks"
        },
        {
          "cell": "lib"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "contexts",
      "ownedPaths": [
        "contexts/**"
      ],
      "publicEntry": "contexts/diagram-context.tsx",
      "publicSymbols": [
        "DiagramProvider",
        "useDiagram"
      ],
      "consumes": [
        {
          "cell": "components"
        },
        {
          "cell": "lib"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "hooks",
      "ownedPaths": [
        "hooks/**"
      ],
      "publicEntry": "hooks/use-diagram-tool-handlers.ts",
      "publicSymbols": [
        "useDiagramToolHandlers"
      ],
      "consumes": [
        {
          "cell": "components"
        },
        {
          "cell": "lib"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "lib",
      "ownedPaths": [
        "lib/**"
      ],
      "publicEntry": "lib/admin/auth.ts",
      "publicSymbols": [
        "checkAdminAuth",
        "MaskedSecret",
        "maskSecret"
      ],
      "consumes": [
        {
          "cell": "components"
        },
        {
          "cell": "hooks"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "mcp-server",
      "ownedPaths": [
        "packages/mcp-server/src/**"
      ],
      "publicEntry": "packages/mcp-server/src/index.ts",
      "publicSymbols": [],
      "packageName": "@next-ai-drawio/mcp-server",
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
