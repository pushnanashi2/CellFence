{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "packages/commitlint/**",
      "packages/eslint-ts-next/**",
      "packages/eslint-ts-react/**",
      "packages/eslint-ts/**",
      "packages/jest-ts-react/**",
      "packages/jest-ts/**",
      "packages/prettier/**",
      "packages/remark/**",
      "packages/syncpack/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__generated__/**",
      "**/__mocks__/**",
      "**/__snapshots__/**",
      "**/__testfixtures__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.snap",
      "**/*.snapshot.*",
      "**/*.spec.*",
      "**/*.test-*.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/codemod/**",
      "**/codemods/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/dts-test/**",
      "**/e2e/**",
      "**/e2e-tests/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixture-generated/**",
      "**/fixtures/**",
      "**/fixtures-generated/**",
      "**/generated/**",
      "**/guides/**",
      "**/integration-tests/**",
      "**/playground/**",
      "**/playgrounds/**",
      "**/*playground*/**",
      "**/template/**",
      "**/templates/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**",
      "__fixtures__/**",
      "__generated__/**",
      "__mocks__/**",
      "__snapshots__/**",
      "__testfixtures__/**",
      "__tests__/**",
      "bench/**",
      "benchmark/**",
      "benchmarks/**",
      "build/**",
      "codemod/**",
      "codemods/**",
      "demo/**",
      "demos/**",
      "dist/**",
      "dts-test/**",
      "e2e/**",
      "e2e-tests/**",
      "example/**",
      "examples/**",
      "fixture/**",
      "fixture-generated/**",
      "fixtures/**",
      "fixtures-generated/**",
      "generated/**",
      "guides/**",
      "integrations/**",
      "integration-tests/**",
      "playground/**",
      "playgrounds/**",
      "*playground*/**",
      "template/**",
      "templates/**",
      "test/**",
      "tests/**",
      "third_party/**",
      "vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_UNSUPPORTED_TYPESCRIPT_SYNTAX",
      "CELLFENCE_UNSUPPORTED_PYTHON_SYNTAX",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "configs-commitlint",
      "ownedPaths": [
        "packages/commitlint/**"
      ],
      "publicEntry": "packages/commitlint/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-commitlint",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-eslint-ts",
      "ownedPaths": [
        "packages/eslint-ts/**"
      ],
      "publicEntry": "packages/eslint-ts/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-eslint-ts",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-eslint-ts-next",
      "ownedPaths": [
        "packages/eslint-ts-next/**"
      ],
      "publicEntry": "packages/eslint-ts-next/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-eslint-ts-next",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-eslint-ts-react",
      "ownedPaths": [
        "packages/eslint-ts-react/**"
      ],
      "publicEntry": "packages/eslint-ts-react/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-eslint-ts-react",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-jest-ts",
      "ownedPaths": [
        "packages/jest-ts/**"
      ],
      "publicEntry": "packages/jest-ts/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-jest-ts",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-jest-ts-react",
      "ownedPaths": [
        "packages/jest-ts-react/**"
      ],
      "publicEntry": "packages/jest-ts-react/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-jest-ts-react",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-prettier",
      "ownedPaths": [
        "packages/prettier/**"
      ],
      "publicEntry": "packages/prettier/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-prettier",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-remark",
      "ownedPaths": [
        "packages/remark/**"
      ],
      "publicEntry": "packages/remark/index.js",
      "publicSymbols": [
        "default"
      ],
      "packageName": "@muravjev/configs-remark",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "configs-syncpack",
      "ownedPaths": [
        "packages/syncpack/**"
      ],
      "publicEntry": "packages/syncpack/index.js",
      "publicSymbols": [],
      "packageName": "@muravjev/configs-syncpack",
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
