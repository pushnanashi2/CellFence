{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "packages/ios-benchmark/src/**",
      "packages/native-showcase/src/**",
      "packages/sandbox/src/**",
      "packages/styled-components/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "ios-benchmark",
      "ownedPaths": [
        "packages/ios-benchmark/src/**"
      ],
      "publicEntry": "packages/ios-benchmark/src/app/App.tsx",
      "publicSymbols": [
        "default"
      ],
      "packageName": "ios-benchmark",
      "consumes": [
        {
          "cell": "styled-components"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "native-showcase",
      "ownedPaths": [
        "packages/native-showcase/src/**"
      ],
      "publicEntry": "packages/native-showcase/src/components/captionStyles.ts",
      "publicSymbols": [
        "darkChip"
      ],
      "packageName": "native-showcase",
      "consumes": [
        {
          "cell": "styled-components"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "sandbox",
      "ownedPaths": [
        "packages/sandbox/src/**"
      ],
      "publicEntry": "packages/sandbox/src/Button.example.tsx",
      "publicSymbols": [
        "default"
      ],
      "packageName": "sandbox",
      "consumes": [
        {
          "cell": "styled-components"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "styled-components",
      "ownedPaths": [
        "packages/styled-components/src/**"
      ],
      "publicEntry": "packages/styled-components/src/index.ts",
      "publicSymbols": [
        "__PRIVATE__",
        "Attrs",
        "CompiledAst",
        "createGlobalStyle",
        "createTheme",
        "css",
        "CSSKeyframes",
        "CSSObject",
        "CSSProp",
        "CSSProperties",
        "CSSPseudos",
        "DataAttributes",
        "default",
        "DefaultTheme",
        "ExecutionContext",
        "ExecutionProps",
        "extractCSS",
        "FastOmit",
        "ICompilerContext",
        "Interpolation",
        "isStyledComponent",
        "IStyledComponent",
        "IStyledComponentFactory",
        "IStyledStatics",
        "IStyleSheetContext",
        "IStyleSheetManager",
        "keyframes",
        "Keyframes",
        "LibraryStyled",
        "PolymorphicComponent",
        "PolymorphicComponentProps",
        "RuleSet",
        "Runtime",
        "ServerStyleSheet",
        "ShouldForwardProp",
        "styled",
        "Styled",
        "StyledInstance",
        "StyledObject",
        "StyledOptions",
        "StyleFunction",
        "StyleSheetConsumer",
        "StyleSheetContext",
        "StyleSheetManager",
        "SupportedHTMLElements",
        "ThemeConsumer",
        "ThemeContext",
        "ThemeProvider",
        "useTheme",
        "version",
        "WebTarget",
        "withTheme"
      ],
      "packageName": "styled-components",
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
