{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "src-root",
      "ownedPaths": [
        "src/*"
      ],
      "publicEntry": "src/index.ts",
      "publicSymbols": [
        "$",
        "argv",
        "bus",
        "cd",
        "chalk",
        "defaults",
        "dotenv",
        "Duration",
        "echo",
        "expBackoff",
        "Fail",
        "fetch",
        "fs",
        "glob",
        "globby",
        "kill",
        "log",
        "LogEntry",
        "MAML",
        "minimist",
        "nothrow",
        "Options",
        "os",
        "parseArgv",
        "path",
        "ProcessOutput",
        "ProcessPromise",
        "ps",
        "question",
        "quiet",
        "quote",
        "quotePowerShell",
        "resolveDefaults",
        "retry",
        "Shell",
        "sleep",
        "spinner",
        "stdin",
        "syncProcessCwd",
        "tempdir",
        "tempfile",
        "tmpdir",
        "tmpfile",
        "updateArgv",
        "useBash",
        "usePowerShell",
        "usePwsh",
        "version",
        "VERSION",
        "versions",
        "which",
        "within",
        "YAML"
      ],
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
