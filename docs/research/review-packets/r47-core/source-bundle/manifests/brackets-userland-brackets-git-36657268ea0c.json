{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__generated__/**",
      "**/__mocks__/**",
      "**/__snapshots__/**",
      "**/__testfixtures__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.snap",
      "**/*.snapshot.*",
      "**/*.spec.*",
      "**/*.test-*.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/codemod/**",
      "**/codemods/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/dts-test/**",
      "**/e2e/**",
      "**/e2e-tests/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixture-generated/**",
      "**/fixtures/**",
      "**/fixtures-generated/**",
      "**/generated/**",
      "**/guides/**",
      "**/integration-tests/**",
      "**/playground/**",
      "**/playgrounds/**",
      "**/*playground*/**",
      "**/template/**",
      "**/templates/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**",
      "__fixtures__/**",
      "__generated__/**",
      "__mocks__/**",
      "__snapshots__/**",
      "__testfixtures__/**",
      "__tests__/**",
      "bench/**",
      "benchmark/**",
      "benchmarks/**",
      "build/**",
      "codemod/**",
      "codemods/**",
      "demo/**",
      "demos/**",
      "dist/**",
      "dts-test/**",
      "e2e/**",
      "e2e-tests/**",
      "example/**",
      "examples/**",
      "fixture/**",
      "fixture-generated/**",
      "fixtures/**",
      "fixtures-generated/**",
      "generated/**",
      "guides/**",
      "integrations/**",
      "integration-tests/**",
      "playground/**",
      "playgrounds/**",
      "*playground*/**",
      "template/**",
      "templates/**",
      "test/**",
      "tests/**",
      "third_party/**",
      "vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_UNSUPPORTED_TYPESCRIPT_SYNTAX",
      "CELLFENCE_UNSUPPORTED_PYTHON_SYNTAX",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "declarations",
      "ownedPaths": [
        "src/declarations/**"
      ],
      "publicEntry": "src/declarations/brackets.ts",
      "publicSymbols": [],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "dialogs",
      "ownedPaths": [
        "src/dialogs/**"
      ],
      "publicEntry": "src/dialogs/Clone.ts",
      "publicSymbols": [
        "show"
      ],
      "consumes": [
        {
          "cell": "git"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "ftp",
      "ownedPaths": [
        "src/ftp/**"
      ],
      "publicEntry": "src/ftp/Ftp.ts",
      "publicSymbols": [],
      "consumes": [
        {
          "cell": "git"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "git",
      "ownedPaths": [
        "src/git/**"
      ],
      "publicEntry": "src/git/get-merge-info.ts",
      "publicSymbols": [
        "default"
      ],
      "consumes": [
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "node",
      "ownedPaths": [
        "src/node/**"
      ],
      "publicEntry": "src/node/cli.ts",
      "publicSymbols": [
        "DomainManager",
        "init"
      ],
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "src-root",
      "ownedPaths": [
        "src/*"
      ],
      "publicEntry": "src/brackets-modules.ts",
      "publicSymbols": [
        "_",
        "AppInit",
        "CodeInspection",
        "CommandManager",
        "Commands",
        "DefaultDialogs",
        "Dialogs",
        "DocumentManager",
        "EditorManager",
        "ExtensionManager",
        "ExtensionUtils",
        "FileSyncManager",
        "FileSystem",
        "FileUtils",
        "FileViewController",
        "FindInFiles",
        "KeyBindingManager",
        "LanguageManager",
        "MainViewManager",
        "Menus",
        "Mustache",
        "NativeApp",
        "NodeConnection",
        "platform",
        "PopUpManager",
        "PreferencesManager",
        "ProjectManager",
        "StringUtils",
        "WorkspaceManager"
      ],
      "consumes": [
        {
          "cell": "dialogs"
        },
        {
          "cell": "git"
        },
        {
          "cell": "utils"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "utils",
      "ownedPaths": [
        "src/utils/**"
      ],
      "publicEntry": "src/utils/Setup.ts",
      "publicSymbols": [
        "findGit"
      ],
      "consumes": [
        {
          "cell": "git"
        },
        {
          "cell": "src-root"
        }
      ],
      "producesArtifacts": []
    }
  ]
}
