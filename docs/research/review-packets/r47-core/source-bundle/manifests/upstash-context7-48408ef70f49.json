{
  "schemaVersion": "cellfence.manifest.v1",
  "governance": {
    "requireOwnership": true,
    "include": [
      "packages/cli/src/**",
      "packages/mcp/src/**",
      "packages/pi/**",
      "packages/sdk/src/**",
      "packages/tools-ai-sdk/src/**"
    ],
    "exclude": [
      "**/__fixtures__/**",
      "**/__mocks__/**",
      "**/__tests__/**",
      "**/*.bench.*",
      "**/*.benchmark.*",
      "**/*.css",
      "**/*.d.ts",
      "**/*.gen.*",
      "**/*.generated.*",
      "**/*.gif",
      "**/*.jpeg",
      "**/*.jpg",
      "**/*.less",
      "**/*.md",
      "**/*.module.css",
      "**/*.module.scss",
      "**/*.png",
      "**/*.sass",
      "**/*.scss",
      "**/*.spec.*",
      "**/*.stories.*",
      "**/*.story.*",
      "**/*.styl",
      "**/*.svg",
      "**/*.test.*",
      "**/*.vue",
      "**/*.webp",
      "**/bench/**",
      "**/benchmark/**",
      "**/benchmarks/**",
      "**/build/**",
      "**/demo/**",
      "**/demos/**",
      "**/dist/**",
      "**/example/**",
      "**/examples/**",
      "**/fixture/**",
      "**/fixtures/**",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/third_party/**",
      "**/vendor/**"
    ],
    "requiredRules": [
      "CELLFENCE_OWNERSHIP_OVERLAP",
      "CELLFENCE_UNOWNED_SOURCE",
      "CELLFENCE_UNOWNED_IMPORT_TARGET",
      "CELLFENCE_PUBLIC_ENTRY_OUTSIDE_OWNERSHIP",
      "CELLFENCE_ARTIFACT_OUTSIDE_OWNERSHIP",
      "CELLFENCE_SYMLINK_TARGET_OUTSIDE_OWNERSHIP",
      "CELLFENCE_PRIVATE_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_IMPORT",
      "CELLFENCE_UNSUPPORTED_DYNAMIC_REQUIRE",
      "CELLFENCE_REQUIRED_RULE_DISABLED",
      "CELLFENCE_WAIVER_INVALID"
    ]
  },
  "cells": [
    {
      "id": "context7-mcp",
      "ownedPaths": [
        "packages/mcp/src/**"
      ],
      "publicEntry": "packages/mcp/src/index.ts",
      "publicSymbols": [],
      "packageName": "@upstash/context7-mcp",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "context7-pi",
      "ownedPaths": [
        "packages/pi/**"
      ],
      "publicEntry": "packages/pi/eslint.config.js",
      "publicSymbols": [
        "default"
      ],
      "packageName": "@upstash/context7-pi",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "context7-sdk",
      "ownedPaths": [
        "packages/sdk/src/**"
      ],
      "publicEntry": "packages/sdk/src/client.ts",
      "publicSymbols": [
        "Context7"
      ],
      "packageName": "@upstash/context7-sdk",
      "consumes": [],
      "producesArtifacts": []
    },
    {
      "id": "context7-tools-ai-sdk",
      "ownedPaths": [
        "packages/tools-ai-sdk/src/**"
      ],
      "publicEntry": "packages/tools-ai-sdk/src/index.ts",
      "publicSymbols": [
        "AGENT_PROMPT",
        "Context7Agent",
        "Context7AgentConfig",
        "Context7Config",
        "Context7ToolsConfig",
        "Documentation",
        "GetContextOptions",
        "Library",
        "QUERY_DOCS_DESCRIPTION",
        "queryDocs",
        "RESOLVE_LIBRARY_ID_DESCRIPTION",
        "resolveLibraryId",
        "SYSTEM_PROMPT"
      ],
      "packageName": "@upstash/context7-tools-ai-sdk",
      "consumes": [
        {
          "cell": "context7-sdk"
        }
      ],
      "producesArtifacts": []
    },
    {
      "id": "ctx7",
      "ownedPaths": [
        "packages/cli/src/**"
      ],
      "publicEntry": "packages/cli/src/index.ts",
      "publicSymbols": [],
      "packageName": "ctx7",
      "consumes": [],
      "producesArtifacts": []
    }
  ]
}
