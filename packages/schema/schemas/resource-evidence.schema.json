{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellfence.dev/schema/resource-evidence-v1.json",
  "title": "CellFence Resource Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accesses"],
  "properties": {
    "schemaVersion": { "const": "cellfence.resource-evidence.v1" },
    "commitSha": { "type": "string" },
    "generatedAt": {
      "anyOf": [
        { "const": "" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "cellId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "accesses": { "type": "array", "items": { "$ref": "#/$defs/access" } }
  },
  "allOf": [{
    "if": { "not": { "properties": { "cellId": {} }, "required": ["cellId"] } },
    "then": {
      "properties": {
        "accesses": {
          "type": "array",
          "items": { "type": "object", "properties": { "cellId": {} }, "required": ["cellId"] }
        }
      }
    }
  }],
  "$defs": {
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "access", "selector"],
      "properties": {
        "kind": { "enum": ["file", "database", "queue", "http"] },
        "access": { "enum": ["read", "write", "publish", "subscribe", "call", "serve"] },
        "selector": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "detectedBy": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low", "runtime"] },
        "cellId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "observedAt": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    }
  }
}
